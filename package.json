{
  "name": "immo24-studioassistent",
  "version": "2026.11.0-beta.1",
  "main": "dist-electron/index.js",
  "description": "Applikation zur Dateiorganisation auf vernetzten Avid Pro Tools Systemen",
  "author": "Philipp Menzel",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Robotron80/immo24-studioassistent.git"
  },
  "homepage": "https://github.com/Robotron80/immo24-studioassistent",
  "bugs": {
    "url": "https://github.com/Robotron80/immo24-studioassistent/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.app.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/core/*.test.ts\"",
    "test:app": "node --test --test-concurrency=1 \"tests/app/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:app",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mdi/js": "7.4.47",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "pinia": "^3.0.3",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.89.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.1",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.5",
    "vuetify": "^3.13.7"
  }
}
