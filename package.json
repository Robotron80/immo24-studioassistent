{
  "name": "immo24-studioassistent",
  "version": "1.0.0-next.9",
  "main": "dist-electron/index.js",
  "description": "Applikation zur Dateiorganisation auf vernetzten Avid Pro Tools Systemen",
  "author": "Philipp Menzel",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Robotron80/immo24-studioassistent.git"
  },
  "homepage": "https://github.com/Robotron80/immo24-studioassistent",
  "bugs": {
    "url": "https://github.com/Robotron80/immo24-studioassistent/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.app.json",
    "test": "node --test tests/backend.test.cjs",
    "test:contract": "node --test \"tests/contract/*.test.cjs\"",
    "test:core": "node --experimental-strip-types --no-warnings --test \"tests/core/*.test.ts\"",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@mdi/font": "7.4.47",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.0.12",
    "express": "4.22.3",
    "node-red": "^5.0.9",
    "node-red-contrib-fs-extra": "^1.0.1",
    "node-red-contrib-fs-ops": "^1.6.0",
    "node-red-contrib-os": "^0.2.1",
    "pinia": "^3.0.3",
    "sass-embedded": "^1.89.2",
    "typescript": "~6.0.2",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.1",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.5",
    "vuetify": "^3.9.3"
  }
}
