    "response": {
      "status": 200,
      "body": {
        "ok": true,
        "results": [
          {
            "name": "Zweite",
            "action": "written"
          },
          {
            "name": "Ärger",
            "action": "written"
          }
        ],
        "count": 2
      }
    }
  },
  {
    "step": "Hänger: Mitarbeiter ohne Namen",
    "request": "POST /api/user",
    "response": {
      "hang": true
    }
  },
  {
    "step": "Mitarbeiter: Kürzel ändern, andere Schreibweise",
