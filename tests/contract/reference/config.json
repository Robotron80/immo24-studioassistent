[
  {
    "step": "Bereit",
    "request": "GET /api/ping",
    "response": {
      "status": 200,
      "body": {
        "ok": true
      }
    }
  },
  {
    "step": "Noch nicht eingerichtet",
    "request": "GET /api/initialize",
    "response": {
      "status": 503,
      "body": {
        "ready": true,
        "initialize": {
          "paths_json_present": false,
          "required_keys_ok": false,
          "schema_ok": false,
          "dirs_exist": null,
          "missingKeys": [
            "PathProduktionen",
            "PathMitarbeiter"
          ],
          "emptyKeys": [
            "PathProduktionen",
            "PathMitarbeiter"
          ],
          "notFoundDirs": null,
          "needsUserAction": true
        }
      }
    }
  },
  {
    "step": "Pfade leer",
    "request": "GET /api/paths",
    "response": {
      "status": 200,
      "body": {
        "data": {},
        "version": "<VERSION>"
      }
    }
  },
  {
    "step": "Pfade: kaputter Body",
    "request": "PUT /api/paths",
    "response": {
      "status": 400,
      "body": {
        "error": "bad_payload"
      }
    }
  },
  {
    "step": "Pfade: Versionskonflikt",
    "request": "PUT /api/paths",
    "response": {
      "status": 409,
      "body": {
        "error": "version_conflict",
        "currentVersion": "<VERSION>"
      }
    }
  },
  {
    "step": "Pfade speichern",
    "request": "PUT /api/paths",
    "response": {
      "status": 200,
      "body": {
        "ok": true,
        "version": "<VERSION>"
      }
    }
  },
  {
    "step": "Pfade: alte Version erneut",
    "request": "PUT /api/paths",
    "response": {
      "status": 409,
      "body": {
        "error": "version_conflict",
        "currentVersion": "<VERSION>"
      }
    }
  },
  {
    "step": "Pfade lesen",
    "request": "GET /api/paths",
    "response": {
      "status": 200,
      "body": {
        "data": {
          "PathMitarbeiter": "<BASE>/Mitarbeiter",
          "PathProduktionen": "<BASE>/Produktionen",
          "PathStammdaten": "<BASE>/Stammdaten",
          "PathPTUser": "<BASE>/ProToolsUser"
        },
        "version": "<VERSION>"
      }
    }
  },
  {
    "step": "Pfade: neue Version gilt",
    "request": "PUT /api/paths",
    "response": {
      "status": 200,
      "body": {
        "ok": true,
        "version": "<VERSION>"
      }
    }
  },
  {
    "step": "Pfade da, Schema fehlt",
    "request": "GET /api/initialize",
    "response": {
      "status": 200,
      "body": {
        "ready": true,
        "initialize": {
          "paths_json_present": true,
          "required_keys_ok": true,
          "schema_ok": false,
          "dirs_exist": null,
          "missingKeys": [],
          "emptyKeys": [],
          "notFoundDirs": null,
          "needsUserAction": true
        },
        "paths": {
          "PathMitarbeiter": "<BASE>/Mitarbeiter",
          "PathProduktionen": "<BASE>/Produktionen",
          "PathStammdaten": "<BASE>/Stammdaten",
          "PathPTUser": "<BASE>/ProToolsUser"
        },
        "schema": {
          "sessionSchema": "",
          "projektordnerSchema": ""
        },
        "modules": {}
      }
    }
  },
  {
    "step": "Schema fehlt",
    "request": "GET /api/schema",
    "response": {
      "status": 404,
      "body": {
        "data": {},
        "version": null,
        "initialize": {
          "paths_json_present": true,
          "required_keys_ok": true,
          "schema_ok": false,
          "dirs_exist": null,
          "missingKeys": [],
          "emptyKeys": [],
          "notFoundDirs": null,
          "needsUserAction": true
        }
      }
    }
  },
  {
    "step": "Schema: kaputter Body",
    "request": "PUT /api/schema",
    "response": {
      "status": 400,
      "body": {
        "error": "bad_payload"
      }
    }
  },
  {
    "step": "Schema speichern",
    "request": "PUT /api/schema",
    "response": {
      "status": 200,
      "body": {
        "projektordnerSchema": "{{datum}} {{projektname}} {{moid}}",
        "sessionSchema": "{{projektname}} {{moid}} {{version}}"
      }
    }
  },
  {
    "step": "Schema lesen",
    "request": "GET /api/schema",
    "response": {
      "status": 200,
      "body": {
        "data": {
          "projektordnerSchema": "{{datum}} {{projektname}} {{moid}}",
          "sessionSchema": "{{projektname}} {{moid}} {{version}}"
        },
        "version": "<VERSION>"
      }
    }
  },
  {
    "step": "Passwort: nichts gesetzt",
    "request": "POST /api/check-password",
    "response": {
      "status": 401,
      "body": {
        "ok": false
      }
    }
  },
  {
    "step": "Passwort: fehlt",
    "request": "POST /api/check-password",
    "response": {
      "status": 400,
      "body": {
        "ok": false,
        "error": "missing_password"
      }
    }
  },
  {
    "step": "Passwort setzen: Felder fehlen",
    "request": "POST /api/adminpw",
    "response": {
      "status": 400,
      "body": {
        "ok": false,
        "error": "missing_fields"
      }
    }
  },
  {
    "step": "Passwort setzen: ungleich",
    "request": "POST /api/adminpw",
    "response": {
      "status": 422,
      "body": {
        "ok": false,
        "error": "password_mismatch"
      }
    }
  },
  {
    "step": "Passwort setzen",
    "request": "POST /api/adminpw",
    "response": {
      "status": 200,
      "body": {
        "ok": true
      }
    }
  },
  {
    "step": "Passwort: richtig",
    "request": "POST /api/check-password",
    "response": {
      "status": 200,
      "body": {
        "ok": true
      }
    }
  },
  {
    "step": "Passwort: falsch",
    "request": "POST /api/check-password",
    "response": {
      "status": 401,
      "body": {
        "ok": false
      }
    }
  },
  {
    "step": "Module leer",
