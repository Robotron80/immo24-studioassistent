      "status": 409,
      "body": {
        "error": "version_required",
        "currentVersion": "<VERSION>"
      }
    }
  },
  {
    "step": "Module: Versionskonflikt",
    "request": "PUT /api/modules",
    "response": {
      "status": 409,
      "body": {
        "error": "version_conflict",
        "currentVersion": "<VERSION>"
      }
    }
  },
  {
    "step": "Module speichern",
    "request": "PUT /api/modules",
    "response": {
      "status": 200,
      "body": {
        "ok": true,
        "version": "<VERSION>"
      }
    }
  },
  {
    "step": "Module lesen",
